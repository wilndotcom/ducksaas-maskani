# Database
DATABASE_URL="postgresql://ducksaas:change_me@localhost:5432/ducksaas_maskani"

# Postgres credentials (used by docker-compose; DATABASE_URL password must match POSTGRES_PASSWORD)
POSTGRES_USER="ducksaas"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="ducksaas_maskani"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="your_super_secret_key_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# M-Pesa Daraja (Sandbox) — note: per-landlord M-Pesa/Paystack credentials are
# configured in Maskani → Settings → Payment Gateways, not here.
# These env vars are only used if gateway config is needed at platform level.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"

# Paystack
PAYSTACK_SECRET_KEY="your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="your_paystack_public_key"

# SMS/Email (Optional - for notifications)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Cron (recurring invoice generation: /api/cron/generate-invoices)
CRON_SECRET=""

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Multi-tenancy
NEXT_PUBLIC_ROOT_DOMAIN=""          # e.g. example.com — tenant subdomains are slug.example.com
MASKANI_MASTER_ORG_SLUG="maskani-master"  # master org whose gateway config is copied to new orgs

# Trials & billing
TRIAL_PERIOD_DAYS="14"               # default length when a super admin grants a trial to an org
